# Bidvera Environment Variables

# MCP Security Token
MCP_AUTH_TOKEN=bidvera-dev-token

# Service Hosts & Ports
MCP_HOST=0.0.0.0
TENDER_SEARCH_PORT=8001
COMPANY_KNOWLEDGE_PORT=8002
PRICING_PORT=8003
DOCUMENTS_PORT=8004

# Database
DATABASE_URL=postgresql://bidvera:bidverasecret@localhost:5432/bidvera

# Data & Output Directories
TENDERS_DATA_DIR=./sample-data/tenders
COMPANY_DATA_DIR=./sample-data/company
DOCUMENTS_OUTPUT_DIR=./output/documents

# LLM Provider (Phase 2+)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
